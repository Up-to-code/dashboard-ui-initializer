{
  "name": "@chats-ui/workspace-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stack": "next dev",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:next": "next dev",
    "dev:hono": "next dev",
    "dev:convex": "node -e \"console.log('Convex removed: this template uses local demo services.')\"",
    "dev:convex:once": "node -e \"console.log('Convex removed: this template uses local demo services.')\"",
    "codegen:convex": "node -e \"console.log('Convex codegen removed for UI-only template.')\"",
    "build": "next build && node scripts/ensure-vercel-manifest.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check:convex-runtime": "node scripts/check-convex-runtime.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "^16.3.0-canary.19",
    "next-intl": "^4.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
